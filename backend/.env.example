# LLM provider — woku.shop (OpenAI-compatible), dùng cho mọi agent trừ Analytics
WOKU_API_KEY=sk-xxx
WOKU_BASE_URL=https://llm.wokushop.com/v1
LLM_MODEL=claude-haiku-4-5-20251001

# Analytics agent chạy trên Groq (llama-3.3-70b-versatile)
GROQ_API_KEY=gsk_xxx

# Odoo connection (XML-RPC)
ODOO_URL=https://shopmypham.odoo.com
ODOO_DB=shopmypham
ODOO_USERNAME=admin@example.com
ODOO_PASSWORD=your_api_key_or_password

# FastAPI
APP_HOST=0.0.0.0
APP_PORT=8000
CORS_ORIGIN=http://localhost:3000

# Key cho thao tác admin: POST /api/order/create với confirm=true, POST /api/cache/clear.
# Gửi kèm header X-API-Key. Để trống = các endpoint admin bị tắt (403).
# Tạo key: python -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_API_KEY=

# Langfuse (optional)
LANGFUSE_PUBLIC_KEY=pk-lf-xxx
LANGFUSE_SECRET_KEY=sk-lf-xxx
LANGFUSE_HOST=https://cloud.langfuse.com
